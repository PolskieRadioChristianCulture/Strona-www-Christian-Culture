      "hour": 9,
      "minute": 0,
      "seriesType": "mission-report",
      "seriesLabel": "DZIENNIK MISJI",
      "defaultVisibility": "PUBLICZNY",
      "notifyPatronsEmail": false
    },
    {
      "id": "wednesday-behind-the-scenes",
      "weekday": 3,
      "weekdayName": "Środa",
      "hour": 18,
      "minute": 0,
      "seriesType": "behind-the-scenes",
      "seriesLabel": "ZA KULISAMI CHRISTIAN CULTURE",
      "defaultVisibility": "PUBLICZNY",
      "notifyPatronsEmail": false
    },
    {
      "id": "friday-thank-you",
      "weekday": 5,
      "weekdayName": "Piątek",
      "hour": 10,
      "minute": 0,
      "seriesType": "thank-you",
      "seriesLabel": "DZIĘKI, ŻE JESTEŚ",
      "defaultVisibility": "PUBLICZNY",
      "notifyPatronsEmail": false
    }
