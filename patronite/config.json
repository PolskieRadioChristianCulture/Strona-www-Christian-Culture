  "graphics": {
    "templateBaseName": "DOBRO, KTÓRE TWORZYMY RAZEM",
    "width": 1068,
    "height": 630,
    "format": "png",
    "maxBytes": 10485760,
    "companionSquareSize": 1080,
    "palette": ["#0D223B", "#E8431B", "#FFFFFF"],
    "maxDominantColors": 3,
    "maxMainBlocks": 3,
    "logoPath": "patronite/templates/assets/brand-header-lockup.png"
  },
  "paths": {
    "sqliteDb": "patronite/state/patronite.sqlite",
    "auditLogJsonl": "patronite/logs/audit.jsonl",
    "sourcesSnapshot": "patronite/sources/latest-snapshot.json",
    "draftsDir": "patronite/drafts",
    "publishedDir": "patronite/published",
    "reportsDir": "patronite/reports",
    "testPreviewDir": "test/patronite"
  },
  "integration": {
    "patroniteProfileUrl": "https://patronite.pl/osobowoscplus",
    "officialApiDocsStatus": "NO_PUBLIC_WRITE_API_CLOSED_BETA",
    "officialApiContact": "kontakt@patronite.pl",
    "moderatorRoleSupported": true,
    "allowCredentialStorage": false,
    "allowCaptchaOr2faBypass": false,
    "allowUndocumentedPrivateEndpoints": false
  },
  "permissions": {
    "allowedActions": [
      "create_draft",
      "update_draft",
      "schedule_post",
      "publish_post",
      "read_post"
    ],
    "forbiddenActions": [
      "read_patron_finances",
      "send_private_message",
      "modify_tiers",
      "modify_account_settings"
    ]
  },
  "zrzutka": {
    "directive": "@ICC-ZRZUTKA-001",
    "systemName": "CC Zrzutka Mission Reporter (Mirror 1:1 Patronite)",
    "enabled": true,
    "syncWithPatroniteSchedule": true,
    "fundraiserUrl": "https://zrzutka.pl/rs4g4v",
