rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signed() {
      return request.auth != null &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function validUid(uid) {
      return uid is string && uid.size() > 0 && uid.size() <= 128 &&
        uid != '.' && uid != '..' && !uid.matches('.*[/\\x00-\\x1f].*');
    }
    function kidGate() {
      let path = /databases/$(database)/documents/kids_pilot/config;
      return !exists(path) || get(path).data.get('childUid', '') != request.auth.uid ||
        (get(path).data.get('enabled', false) == true && get(path).data.get('revoked', false) != true);
    }
    function roomPath(roomId) {
      return /databases/$(database)/documents/lumina_family_rooms/$(roomId);
    }
    function kidsSlotsSafe(slots) {
      let path = /databases/$(database)/documents/kids_pilot/config;
      return !exists(path) || !(get(path).data.get('childUid', '') in slots) ||
        (get(path).data.get('contacts', []) is list &&
         slots.hasOnly(get(path).data.get('contacts', []).concat([get(path).data.childUid])));
    }
    function membershipPath(roomId, uid) {
      return /databases/$(database)/documents/lumina_family_rooms/$(roomId)/lumina_family_members/$(uid);
    }
    function guardian(roomId) {
      let root = roomPath(roomId);
      return signed() && kidGate() && familyPinUnlocked(roomId) && exists(root) && get(root).data.ownerUid == request.auth.uid;
    }
    function activeSlot(roomId, uid) {
      let root = roomPath(roomId);
      return exists(root) && get(root).data.status == 'active' && uid in get(root).data.slotUids &&
        kidsSlotsSafe(get(root).data.slotUids);
    }
    function accepted(roomId) {
      let m = membershipPath(roomId, request.auth.uid);
      return signed() && kidGate() && familyPinUnlocked(roomId) && activeSlot(roomId, request.auth.uid) &&
        exists(m) && get(m).data.state == 'accepted' && get(m).data.uid == request.auth.uid &&
        get(m).data.roomId == roomId;
    }
    // Server-only PIN verifier and sessions. No browser may create an unlock.
    function familyPinUnlocked(roomId) {
      let policy = /databases/$(database)/documents/lumina_family_rooms/$(roomId)/security/pin;
      let session = /databases/$(database)/documents/lumina_family_rooms/$(roomId)/pin_sessions/$(request.auth.uid);
      return exists(policy) && exists(session) &&
        get(session).data.version == get(policy).data.version &&
        get(session).data.authTime == request.auth.token.auth_time &&
        get(session).data.expiresAt > request.time;
    }
    function validSlots(s, ownerUid) {
      return s is list && s.size() >= 1 && s.size() <= 4 && s.toSet().size() == s.size() &&
        ownerUid in s && validUid(s[0]) &&
        (s.size() < 2 || validUid(s[1])) && (s.size() < 3 || validUid(s[2])) &&
        (s.size() < 4 || validUid(s[3]));
    }
    function validRoom(d) {
      return d.keys().hasAll(['schemaVersion', 'name', 'ownerUid', 'slotUids', 'status', 'createdAt', 'updatedAt']) &&
        d.keys().hasOnly(['schemaVersion', 'name', 'ownerUid', 'slotUids', 'status', 'createdAt', 'updatedAt']) &&
        d.schemaVersion == 1 && d.name is string && d.name.size() > 0 && d.name.size() <= 80 &&
        validUid(d.ownerUid) && validSlots(d.slotUids, d.ownerUid) && kidsSlotsSafe(d.slotUids) &&
        d.status in ['active', 'closed'] && d.createdAt is timestamp && d.updatedAt is timestamp;
    }
    function validMembership(d, roomId, uid) {
      return d.keys().hasAll(['roomId', 'uid', 'invitedBy', 'state', 'revision', 'createdAt', 'updatedAt', 'expiresAt']) &&
        d.keys().hasOnly(['roomId', 'uid', 'invitedBy', 'state', 'revision', 'createdAt', 'updatedAt', 'expiresAt']) &&
        d.roomId == roomId && d.roomId is string && d.roomId.size() <= 128 &&
        d.uid == uid && validUid(d.uid) && validUid(d.invitedBy) &&
        d.state in ['pending', 'accepted', 'declined', 'revoked'] &&
        d.revision is int && d.revision >= 1 && d.revision <= 3 &&
        d.createdAt is timestamp && d.updatedAt is timestamp && d.expiresAt is timestamp;
    }
    function guardianInvite(d, roomId, uid) {
      let r = getAfter(roomPath(roomId)).data;
      return guardian(roomId) && uid != request.auth.uid && r.status == 'active' && uid in r.slotUids &&
        kidsSlotsSafe(r.slotUids) &&
        d.invitedBy == request.auth.uid && d.state == 'pending' &&
        d.createdAt == request.time && d.updatedAt == request.time &&
        d.expiresAt > request.time && d.expiresAt <= request.time + duration.value(7, 'd');
    }
    function answer(d, roomId, uid) {
      return signed() && kidGate() && request.auth.uid == uid &&
        resource.data.state == 'pending' && resource.data.expiresAt > request.time &&
        activeSlot(roomId, uid) && d.state in ['accepted', 'declined'] &&
        d.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']) && d.updatedAt == request.time;
    }
    function revoke(d, roomId, uid) {
      return guardian(roomId) && uid != request.auth.uid && d.state == 'revoked' &&
        d.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']) && d.updatedAt == request.time;
    }
    function leaveFamily(d, roomId, uid) {
      return signed() && request.auth.uid == uid &&
        get(roomPath(roomId)).data.ownerUid != uid && resource.data.state == 'accepted' &&
        d.state == 'declined' &&
        d.diff(resource.data).affectedKeys().hasOnly(['state', 'updatedAt']) && d.updatedAt == request.time;
    }
    match /lumina_family_rooms/{roomId} {
      allow get: if guardian(roomId) || accepted(roomId);
      allow list, create, delete: if false;
      allow update: if guardian(roomId) && validRoom(request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'slotUids', 'status', 'updatedAt']) &&
        request.resource.data.updatedAt == request.time;

      match /lumina_family_members/{uid} {
        allow get: if (signed() && kidGate() && uid == request.auth.uid) || guardian(roomId) ||
          (accepted(roomId) && resource.data.state == 'accepted');
        allow list: if request.query.limit != null && request.query.limit <= 4 &&
          (guardian(roomId) || (accepted(roomId) && resource.data.state == 'accepted'));
        allow create: if validMembership(request.resource.data, roomId, uid) &&
          guardianInvite(request.resource.data, roomId, uid) && request.resource.data.revision == 1;
        allow update: if validMembership(request.resource.data, roomId, uid) && (
          answer(request.resource.data, roomId, uid) || revoke(request.resource.data, roomId, uid) ||
          leaveFamily(request.resource.data, roomId, uid) ||
          (resource.data.state in ['declined', 'revoked'] &&
           guardianInvite(request.resource.data, roomId, uid) &&
           (resource.data.state != 'declined' || request.time >= resource.data.updatedAt + duration.value(1, 'd')) &&
           request.resource.data.revision == resource.data.revision + 1));
        allow delete: if false;
      }
      match /messages/{messageId} {
        allow get: if accepted(roomId);
        allow list: if accepted(roomId) && request.query.limit != null && request.query.limit <= 50;
        allow create: if accepted(roomId) && validMessage(request.resource.data, messageId);
        allow update, delete: if false;
      }
    }
    function validMessage(d, messageId) {
      return d.keys().hasAll(['senderUid', 'clientMessageId', 'text', 'createdAt']) &&
        d.keys().hasOnly(['senderUid', 'clientMessageId', 'text', 'createdAt']) &&
        d.senderUid == request.auth.uid && validUid(d.senderUid) &&
        d.clientMessageId is string && d.clientMessageId.matches('^[A-Za-z0-9_-]{20,80}$') &&
        messageId == request.auth.uid + '_' + d.clientMessageId &&
        d.text is string && d.text.size() > 0 && d.text.size() <= 1000 &&
        d.createdAt is timestamp && d.createdAt == request.time;
    }
    // Required for the bounded collectionGroup(uid==current UID) invitation inbox.
    // Only the user's own minimal invitation metadata. No room/message permission here.
    match /{parent=**}/lumina_family_members/{uid} {
      allow get: if signed() && kidGate() && uid == request.auth.uid && resource.data.uid == request.auth.uid;
      allow list: if signed() && kidGate() && resource.data.uid == request.auth.uid &&
        request.query.limit != null && request.query.limit <= 20;
    }
    // Anonymous Firebase sessions may browse public content, but never publish,
    // message, react, or change another person's data.
    function isAuthenticated() {
      return request.auth != null;
    }

    function isMember() {
      return isAuthenticated() &&
        request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Private owner-to-agent queue. Immutable commands; receipts are server-only.
    function lumiAgentOwner(uid) {
      return signed() && request.auth.uid == uid &&
        request.auth.token.email_verified == true &&
        request.auth.token.email == 'nazirczarkes@gmail.com' &&
        request.auth.token.ccMissionControl == true;
    }
    function validAgentCommand(d, uid) {
      return d.ownerUid == uid && d.command is string && d.command.size() > 0 &&
        d.command.size() <= 4000 && d.createdAt is timestamp && d.checkAt is timestamp &&
        d.needsSync is bool && d.status in ['queued', 'accepted', 'answered', 'rejected'];
    }
    match /lumi_agent_commands/{uid}/items/{commandId} {
      allow get: if lumiAgentOwner(uid);
      allow list: if lumiAgentOwner(uid) && request.query.limit != null && request.query.limit <= 20;
      allow create: if lumiAgentOwner(uid) &&
        commandId.matches('^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$') &&
        validAgentCommand(request.resource.data, uid) &&
        request.resource.data.keys().hasOnly(['ownerUid','command','createdAt','checkAt','status','needsSync']) &&
        request.resource.data.createdAt == request.time && request.resource.data.checkAt == request.time &&
        request.resource.data.status == 'queued' && request.resource.data.needsSync == true;
      allow update: if lumiAgentOwner(uid) && validAgentCommand(request.resource.data, uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['needsSync','checkAt']) &&
        request.resource.data.needsSync == true && request.resource.data.checkAt == request.time;
      allow delete: if false;
    }

    function isMasterAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        (request.auth.token.email_verified == true &&
         (request.auth.token.email == 'nazirczarkes@gmail.com' ||
          request.auth.token.email == 'radiochristianculture@gmail.com' ||
          request.auth.token.email == 'czarekrogowski3@gmail.com' ||
          request.auth.token.email == 'polskieradiocc@gmail.com' ||
          request.auth.token.email == 'studiodees7@gmail.com' ||
          request.auth.token.email == 'polskiercctv@gmail.com'))
      );
    }

    function ownsProfile(data) {
      return isMember() && data.uid is string && data.uid == request.auth.uid;
    }

    function isMessageParticipant(data) {
      // Optional identity fields differ across room and legacy message schemas.
      // Missing fields must deny that branch, not abort another valid UID check.
      return isMember() && (
        ('senderAuthUid' in data && data.senderAuthUid == request.auth.uid) ||
        ('receiverAuthUid' in data && data.receiverAuthUid == request.auth.uid) ||
        ('participants' in data && data.participants.hasAny([request.auth.uid])) ||
        // Historical messages used `users`; retain access only where the
        // authenticated UID is explicitly present in the existing document.
        ('users' in data && data.users.hasAny([request.auth.uid]))
      );
    }

    // P0 (Strażnik): slugi zastrzeżone dla kont oficjalnych — tylko Master Admin może je nadać.
    function isReservedSlug(slug) {
      return slug in ['cezaryrgowski', 'wiolettarogowska', 'radiocc', 'andrzejthiel', 'christianculture', 'lumina'];
    }

    // P0 (Strażnik): pola uprzywilejowane — zwykły użytkownik nie może ich PODNIEŚĆ.
    // Wartości false / brak pola są dozwolone (formularze rejestracji zapisują np. isVerified: false).
    function elevatedRoles() {
      return ['admin', 'founder', 'moderator', 'owner', 'superadmin'];
    }

    function flagElevated(newData, oldData, k) {
      return newData.get(k, false) == true && oldData.get(k, false) != true;
    }

    function profileCreateIsSafe(data) {
      return !data.keys().hasAny(['email', 'fcmToken', 'fcmTokens']) &&
        !flagElevated(data, {}, 'isAdmin') &&
        !flagElevated(data, {}, 'isFounder') &&
        !flagElevated(data, {}, 'admin') &&
        !flagElevated(data, {}, 'isVerified') &&
        !flagElevated(data, {}, 'verified') &&
        !flagElevated(data, {}, 'isOfficial') &&
        !(data.get('role', 'user') in elevatedRoles()) &&
        !isReservedSlug(data.get('slug', ''));
    }

    function profileUpdateIsSafe() {
      let n = request.resource.data;
      let o = resource.data;
      return privateProfileFieldUnchanged(n, o, 'email') &&
        privateProfileFieldUnchanged(n, o, 'fcmToken') &&
        privateProfileFieldUnchanged(n, o, 'fcmTokens') &&
        !flagElevated(n, o, 'isAdmin') &&
        !flagElevated(n, o, 'isFounder') &&
        !flagElevated(n, o, 'admin') &&
        !flagElevated(n, o, 'isVerified') &&
        !flagElevated(n, o, 'verified') &&
        !flagElevated(n, o, 'isOfficial') &&
        (n.get('role', 'user') == o.get('role', 'user') || !(n.get('role', 'user') in elevatedRoles())) &&
        (n.get('slug', '') == o.get('slug', '') || !isReservedSlug(n.get('slug', '')));
    }

    // ❤️🙏 Reakcje na wpisy: licznik może zmienić się wyłącznie o ±1 RAZEM z utworzeniem/usunięciem
    // własnego dokumentu reakcji (lumina_post_reactions/{postId}_{uid}_{typ}) w tej samej transakcji.
    function reactionPath(postId, t) {
      return /databases/$(database)/documents/lumina_post_reactions/$(postId + '_' + request.auth.uid + '_' + t);
    }

    // Legacy private fields may remain unchanged or be removed, never added.
    function privateProfileFieldUnchanged(n, o, field) {
      return !(field in n) || (field in o && n[field] == o[field]);
    }

    function validPostText(data) {
      return data.text is string && data.text.size() <= 5000;
    }

    function pairedReactionCounter(data, delta) {
      let path = /databases/$(database)/documents/lumina_posts/$(data.postId);
      let before = get(path).data.get(data.type, 0);
      let after = getAfter(path).data.get(data.type, 0);
      return before is int && after is int && after >= 0 && after == before + delta;
    }

    function isValidReactionUpdate(postId) {
      let keys = request.resource.data.diff(resource.data).affectedKeys();
      return isMember() && (
        (keys.hasOnly(['likes']) && reactionCounterMoved(postId, 'likes')) ||
        (keys.hasOnly(['amen']) && reactionCounterMoved(postId, 'amen'))
      );
    }

    function reactionCounterMoved(postId, t) {
      let before = resource.data.get(t, 0);
      let after = request.resource.data.get(t, 0);
      return before is int && after is int && after >= 0 && (
        (after == before + 1 && !exists(reactionPath(postId, t)) && existsAfter(reactionPath(postId, t))) ||
        (after == before - 1 && exists(reactionPath(postId, t)) && !existsAfter(reactionPath(postId, t)))
      );
    }

    function postIdentityIsSafe(data) {
      return !isReservedSlug(data.get('authorSlug', '')) &&
        data.get('author', '') != 'Cezary Rogowski';
    }

    function directMessageAllowed(data) {
      return data.senderAuthUid != data.receiverAuthUid &&
        data.participants.size() == 2 &&
        data.senderAuthUid in data.participants &&
        data.receiverAuthUid in data.participants &&
        !exists(/databases/$(database)/documents/lumina_user_blocks/$(request.auth.uid + '_' + data.receiverAuthUid)) &&
        !exists(/databases/$(database)/documents/lumina_user_blocks/$(data.receiverAuthUid + '_' + request.auth.uid));
    }

    // ── LUMI KIDS (pilotaż rodzinny, Strażnik Claude 2026-10-18) ──────────────────────
    // kids_pilot/config { enabled, revoked, childUid, contacts[], familyChats{} } — zapis WYŁĄCZNIE opiekun
    // (Master Admin). Brak dokumentu = pilotaż wyłączony. Dziecko i rodzic rozmawiają w JEDNYM,
    // zwykłym wątku DM LUMINA (lumina_direct_messages) — bez drugiego magazynu wiadomości.
    function kidsConfigPath() {
      return /databases/$(database)/documents/kids_pilot/config;
    }
    function kidsIsChild() {
      return isAuthenticated() && exists(kidsConfigPath()) &&
        get(kidsConfigPath()).data.get('childUid', '') == request.auth.uid;
    }
    // Konto dziecka nie może pisać w publicznych częściach LUMINA (profil, wpisy, czat ogólny, prośby o kontakt).
    function notKidsChild() {
      return !kidsIsChild();
    }
    function kidsEnabled() {
      return exists(kidsConfigPath()) &&
        get(kidsConfigPath()).data.get('enabled', false) == true &&
        get(kidsConfigPath()).data.get('revoked', false) != true;
    }
    function kidsActive() {
      return isMember() && kidsEnabled() &&
        get(kidsConfigPath()).data.get('childUid', '') is string &&
        get(kidsConfigPath()).data.get('childUid', '') != '';
    }
    // Odczyt/aktualizacja DM: zwykli użytkownicy bez zmian; dziecko tylko gdy pilotaż aktywny
    // (cofnięcie zgody natychmiast odcina odczyt i zapis).
    function kidsChildGate() {
      return !kidsIsChild() || kidsEnabled();
    }
    // Dziecko może napisać WYŁĄCZNIE do zatwierdzonego kontaktu, tylko tekst (bez zdjęć i załączników).
    function kidsChildMayDm(data) {
      return kidsIsChild() && kidsEnabled() &&
        data.receiverAuthUid in get(kidsConfigPath()).data.get('contacts', []) &&
        data.get('type', 'text') == 'text' &&
        !('imageUrl' in data) &&
        data.text.size() > 0 && data.text.size() <= 1000;
    }

    function acceptedConversation(chatId, participants) {
      let path = /databases/$(database)/documents/lumina_message_requests/$(chatId);
      let chat = /databases/$(database)/documents/lumina_chats/$(chatId);
      return chatId is string && participants is list && participants.size() == 2 && (
        (existsAfter(path) && getAfter(path).data.status == 'accepted' &&
          getAfter(path).data.participants.size() == 2 &&
          getAfter(path).data.participants.hasAll(participants)) ||
        // Rozmowa już wcześniej przyjęta (np. otwarta przez administratora albo sprzed próśb o kontakt):
        // liczy się stan PRZED zapisem, więc nikt nie może sam „przyjąć” rozmowy, zmieniając podgląd.
        (exists(chat) && get(chat).data.get('conversationState', '') == 'accepted' &&
          get(chat).data.get('participants', []).size() == 2 &&
          get(chat).data.get('participants', []).hasAll(participants))
      );
    }

    match /lumina_profiles/{profileId} {
      // Public profile cards must contain only intentionally public fields.
      allow read: if true;
      // P0: usunięto furtki `profileId == 'cezaryrgowski'` / `slug == 'cezaryrgowski'`,
      // które pozwalały KAŻDEMU (nawet niezalogowanemu) utworzyć lub nadpisać profil Założyciela.
      allow create: if isMasterAdmin() || (
        ownsProfile(request.resource.data) && notKidsChild() &&
        (profileId == request.auth.uid || profileId == request.resource.data.get('slug', '')) &&
        profileCreateIsSafe(request.resource.data)
      );
      allow update: if isMasterAdmin() || (
        ownsProfile(resource.data) &&
        request.resource.data.uid == resource.data.uid &&
        profileUpdateIsSafe()
      );
      allow delete: if isMasterAdmin() || ownsProfile(resource.data);
    }

    match /users/{userId} {
      // P0: dane prywatne konta — odczyt tylko właściciel i administracja (wcześniej: publiczny).
      allow read: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow create, update: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);

      // Ulubione CC — prywatna lista stron użytkownika (synchronizacja między urządzeniami)
      match /favorites/{favId} {
        allow read, write, delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      }

      // Moje Centrum CC — prywatny pulpit, kafelki i konfiguracja Personal Hub
      match /personal_hub/{docId} {
        allow read, write, delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      }

      // Historia odwiedzin — prywatny rejestr za zgodą użytkownika
      match /history/{histId} {
        allow read, write, delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      }
    }

    match /user_posts/{postId} {
      allow read: if true;
      allow create: if isMasterAdmin() || (isMember() && notKidsChild() && request.resource.data.authorUid == request.auth.uid);
      allow update, delete: if isMasterAdmin() || (isMember() && resource.data.authorUid == request.auth.uid);
    }

    match /lumina_posts/{postId} {
      allow read: if true;
      // P0: wpisy oficjalne (Cezary Rogowski) — wyłącznie zweryfikowany Master Admin.
      // Rozważania CKD (andrzejthiel) publikuje Cloud Function przez Admin SDK, która omija reguły,
      // więc furtka bez logowania nie jest potrzebna. Wcześniej KAŻDY mógł tworzyć, edytować
      // i usuwać wpisy jako Cezary oraz publikować fałszywe CKD wywołujące push do wszystkich.
      allow create: if isMasterAdmin() || (
        isMember() && notKidsChild() &&
        request.resource.data.authorUid == request.auth.uid &&
        postIdentityIsSafe(request.resource.data) &&
        validPostText(request.resource.data) &&
        request.resource.data.get('likes', 0) == 0 &&
        request.resource.data.get('amen', 0) == 0
      );
      allow update: if isMasterAdmin() || isValidReactionUpdate(postId) || (
        isMember() &&
        resource.data.authorUid == request.auth.uid &&
        request.resource.data.authorUid == resource.data.authorUid &&
        postIdentityIsSafe(request.resource.data) &&
        validPostText(request.resource.data) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['likes', 'amen'])
      );
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.authorUid == request.auth.uid
      );
    }

    match /lumina_post_reactions/{reactionId} {
      // Kto zareagował — widzi tylko on sam (prywatność); liczniki są we wpisie.
      allow read: if isMasterAdmin() || (isMember() && resource.data.uid == request.auth.uid);
      allow create: if isMember() &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.type in ['likes', 'amen'] &&
        request.resource.data.postId is string &&
        reactionId == request.resource.data.postId + '_' + request.auth.uid + '_' + request.resource.data.type &&
        request.resource.data.keys().hasOnly(['uid', 'postId', 'type', 'createdAt']) &&
        exists(/databases/$(database)/documents/lumina_posts/$(request.resource.data.postId)) &&
        pairedReactionCounter(request.resource.data, 1);
      allow update: if false;
      allow delete: if isMasterAdmin() || (isMember() && resource.data.uid == request.auth.uid &&
        pairedReactionCounter(resource.data, -1));
    }

    match /lumina_campaigns/{campaignId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    match /lumina_direct_messages/{messageId} {
      allow read: if isMasterAdmin() || (isMessageParticipant(resource.data) && kidsChildGate());
      allow create: if isMasterAdmin() || (
        isMember() && (notKidsChild() || kidsChildMayDm(request.resource.data)) &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.receiverAuthUid is string &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants &&
        directMessageAllowed(request.resource.data) &&
        acceptedConversation(request.resource.data.chatId, request.resource.data.participants) &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 4000
      );
      allow update: if isMasterAdmin() || (
        isMessageParticipant(resource.data) && kidsChildGate() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'isRead', 'status', 'readAt', 'readByName', 'readBy', 'reactions', 'seenBy'
        ])
      );
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.senderAuthUid == request.auth.uid
      );
    }

    match /lumina_message_requests/{requestId} {
      allow read: if isMasterAdmin() || (isMessageParticipant(resource.data) && kidsChildGate());
      allow create: if isMasterAdmin() || (
        isMember() && notKidsChild() &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.receiverAuthUid is string &&
        request.resource.data.participants is list &&
        request.resource.data.previewText is string &&
        request.resource.data.previewText.size() <= 1000 &&
        request.resource.data.status == 'pending' &&
        directMessageAllowed(request.resource.data)
      );
      allow update: if isMasterAdmin() || (
        isMember() && notKidsChild() && resource.data.receiverAuthUid == request.auth.uid &&
        (resource.data.status == 'pending' ||
          (resource.data.status == 'declined' && request.resource.data.status == 'accepted')) &&
        request.resource.data.status in ['accepted', 'declined', 'blocked'] &&
        (request.resource.data.status != 'accepted' ||
          (request.resource.data.acceptedBy == request.auth.uid && request.resource.data.acceptedAt is timestamp)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'acceptedAt', 'acceptedBy', 'respondedAt', 'respondedBy'])
      );
      allow delete: if isMasterAdmin();
    }

    match /lumina_public_chat_messages/{messageId} {
      function validPublicChatText(data) {
        return data.text is string && data.text.size() > 0 && data.text.size() <= 2000 &&
          data.text.matches('(?s).*\\S.*');
      }

      function validAuthorEdit() {
        let changes = request.resource.data.diff(resource.data).affectedKeys();
        return notKidsChild() &&
          resource.data.senderAuthUid == request.auth.uid &&
          changes.hasOnly(['text', 'editedAt']) && changes.hasAll(['text', 'editedAt']) &&
          validPublicChatText(request.resource.data) &&
          request.resource.data.editedAt == request.time;
      }

      allow read: if true;
      allow create: if isMasterAdmin() || (
        isMember() && notKidsChild() &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 2000 &&
        !request.resource.data.keys().hasAny(['editedAt'])
      );
      allow update: if isMasterAdmin() || (
        isMember() && (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'seenBy']) ||
          validAuthorEdit()
        )
      );
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.senderAuthUid == request.auth.uid
      );
    }

    // ── Pokoje LIVE TV w LUMI Messenger (Strażnik 2026-10-19) ─────────────────────────
    // Czat widzów podczas transmisji (CCTV24, Zjednoczeni za Polskę, Master Live…). Publiczny odczyt,
    // pisze tylko zalogowany członek (bez kont dzieci), sam tekst do 1000 znaków, czas serwera.
    match /lumina_live_rooms/{roomId}/messages/{messageId} {
      allow read: if true;
      allow create: if isMember() && notKidsChild() &&
        roomId.matches('^(tv|radio)_[a-z0-9_]{2,40}$') &&
        request.resource.data.keys().hasOnly(['roomId', 'text', 'senderAuthUid', 'senderName', 'senderAvatar', 'kind', 'createdAt']) &&
        request.resource.data.roomId == roomId &&
        request.resource.data.senderAuthUid == request.auth.uid &&
        request.resource.data.text is string &&
        request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000 &&
        request.resource.data.senderName is string && request.resource.data.senderName.size() <= 80 &&
        request.resource.data.senderAvatar is string && request.resource.data.senderAvatar.size() <= 500 &&
        request.resource.data.kind in ['text', 'prayer'] &&
        request.resource.data.createdAt == request.time;
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin() || (isMember() && resource.data.senderAuthUid == request.auth.uid);
    }

    match /lumina_chats/{chatId} {
      allow read: if isMasterAdmin() || (isMessageParticipant(resource.data) && kidsChildGate());
      allow create: if isMasterAdmin() || (
        isMember() && notKidsChild() &&
        request.resource.data.participants is list &&
        request.auth.uid in request.resource.data.participants &&
        (request.resource.data.get('conversationState', '') != 'accepted' ||
          acceptedConversation(chatId, request.resource.data.participants))
      );
      // P0: all fields used by isMessageParticipant are immutable for members.
      allow update: if isMasterAdmin() || (
        isMessageParticipant(resource.data) && kidsChildGate() &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'participants', 'users', 'senderAuthUid', 'receiverAuthUid'
        ]) &&
        (request.resource.data.get('conversationState', '') != 'accepted' ||
          acceptedConversation(chatId, resource.data.get('participants', [])))
      );
      allow delete: if isMasterAdmin();

      match /messages/{messageId} {
        allow read: if isMasterAdmin() || (isMessageParticipant(resource.data) && kidsChildGate());
        allow create: if isMasterAdmin() || (
          isMember() && notKidsChild() &&
          request.resource.data.senderAuthUid == request.auth.uid &&
          request.resource.data.participants is list &&
          request.auth.uid in request.resource.data.participants &&
          request.resource.data.chatId == chatId &&
          directMessageAllowed(request.resource.data) &&
          acceptedConversation(chatId, request.resource.data.participants) &&
          request.resource.data.text is string &&
          request.resource.data.text.size() <= 4000
        );
        allow update: if isMasterAdmin() || (
          isMessageParticipant(resource.data) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'isRead', 'status', 'readAt', 'readByName', 'readBy', 'reactions', 'seenBy'
          ])
        );
        allow delete: if isMasterAdmin() || (
          isMember() && resource.data.senderAuthUid == request.auth.uid
        );
      }
    }

    match /lumina_reports/{reportId} {
      allow create: if isMember() &&
        request.resource.data.reporterAuthUid == request.auth.uid &&
        request.resource.data.reason is string &&
        request.resource.data.reason.size() <= 500;
      allow read, update, delete: if isMasterAdmin();
    }

    // Relationship data is readable only by its owner or trusted moderation.
    // Cloud Functions use Admin SDK and are not restricted by these client rules.
    match /lumina_likes/{likeId} {
      allow read: if isMasterAdmin() || (
        isMember() && resource.data.fromAuthUid == request.auth.uid
      );
      allow create: if isMember() &&
        request.resource.data.fromAuthUid == request.auth.uid &&
        request.resource.data.type is string;
      allow update: if false;
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.fromAuthUid == request.auth.uid
      );
    }

    match /lumina_user_blocks/{blockId} {
      allow read: if isMasterAdmin() || (
        isMember() && resource.data.ownerUid == request.auth.uid
      );
      allow create: if isMember() && request.resource.data.ownerUid == request.auth.uid;
      allow update, delete: if isMasterAdmin() || (
        isMember() && resource.data.ownerUid == request.auth.uid
      );
    }

    match /lumina_presence/{presenceId} {
      allow read: if true;
      allow create: if isMember() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if isMasterAdmin() || (
        isMember() && resource.data.uid == request.auth.uid
      );
    }

    // Odznaki są publicznymi wyróżnieniami profilu członka LUMINA (dostępne do odczytu dla wszystkich).
    // Zapis z poziomu klienta jest zablokowany — Cloud Functions nadaje odznaki przez Admin SDK.
    match /lumina_user_badges/{badgeId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Zagregowane statystyki telemetrii społeczności LUMINA (eliminacja odczytów całej kolekcji profili).
    match /lumina_stats/{statId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Notifications are generated only by trusted server functions.
    match /lumina_notifications/{notifId} {
      allow read, write: if isMasterAdmin();
    }

    match /lumina_notifications/{userId}/archive/{item} {
      allow read: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow update, delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
      allow create: if isMasterAdmin();
    }

    match /lumina_notification_preferences/{userId} {
      allow read, write: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
    }

    match /LuminaDeviceTokens/{tokenId} {
      allow read: if isMasterAdmin();
      allow create, update: if isMember() && request.resource.data.uid == request.auth.uid;
      allow delete: if isMasterAdmin() || (
        isMember() && resource.data.uid == request.auth.uid
      );
    }

    match /prayer_intentions/{intentionId} {
      allow create: if request.resource.data.keys().hasOnly([
        'name', 'city', 'text', 'approved', 'status', 'timestamp'
      ]) &&
        request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120 &&
        request.resource.data.city is string && request.resource.data.city.size() > 0 && request.resource.data.city.size() <= 120 &&
        request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000 &&
        request.resource.data.approved == false &&
        request.resource.data.status == 'pending';
      allow read: if isMasterAdmin() || resource.data.approved == true;
      allow update, delete: if isMasterAdmin();
    }

    // YIS Design Studio 2.0 - Kanoniczne projekty odzieży i gadżetów
    match /yis_projects/{projectId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isMember() && request.resource.data.userId == request.auth.uid && request.resource.data.status in ['SZKIC', 'DO WERYFIKACJI'];
      allow update: if isMasterAdmin() || (
        isMember() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['status']) || request.resource.data.status in ['SZKIC', 'DO WERYFIKACJI'])
      );
      allow delete: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
    }

    // ── LUMINA BIBLE ACADEMY (Kolekcje Kursów Biblijnych 28 Zasad Wiary) ──
    // 1. Postęp w kursach — trwały postęp powiązany ściśle z UID użytkownika
    match /course_progress/{progressId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId is string &&
        (request.resource.data.lessonId is int || request.resource.data.lessonId is string);
      allow update: if isMasterAdmin() || (
        isMember() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
    }

    // 2. Osiągnięcia kursowe — czytelne publicznie (dla profili i odznak), zapis ściśle dla właściciela UID
    match /course_achievements/{achievementId} {
      allow read: if true;
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.achievementId is string;
      allow update: if isMasterAdmin() || (
        isMember() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == resource.data.userId
      );
      allow delete: if isMasterAdmin();
    }

    // 3. Prywatny Dziennik Drogi — BEZWZGLĘDNIE ŚCIŚLE PRYWATNY (tylko właściciel UID)
    match /course_journal/{journalId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        (request.resource.data.lessonId is int || request.resource.data.lessonId is string);
      allow update: if isMember() && 
        resource.data.userId == request.auth.uid && 
        request.resource.data.userId == resource.data.userId;
      allow delete: if isMember() && resource.data.userId == request.auth.uid;
    }

    // 4. Zgłoszenia opieki duchowej — POUFNE (tylko autor i administracja)
    match /spiritual_care_requests/{requestId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'new' &&
        request.resource.data.message is string &&
        request.resource.data.message.size() <= 3000;
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // 5. Próby quizowe — wyniki prywatne dla właściciela UID, brak publicznej emisji
    match /quiz_attempts/{attemptId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.courseId is string &&
        (request.resource.data.lessonId is int || request.resource.data.lessonId is string) &&
        request.resource.data.score is int &&
        ((request.resource.data.keys().hasAny(['totalQuestions']) && request.resource.data.totalQuestions is int) ||
         (request.resource.data.keys().hasAny(['total']) && request.resource.data.total is int));
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
    }

    // 6. Preferencje publikacji osiągnięć (ask_each_time, always, never) — ściśle prywatne
    match /course_preferences/{userId} {
      allow read: if isMasterAdmin() || (isMember() && resource.data.userId == request.auth.uid);
      allow create, update: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.auth.uid == userId &&
        request.resource.data.publishAchievements in ['ask_each_time', 'always', 'never'];
      allow delete: if isMasterAdmin() || (isMember() && request.auth.uid == userId);
    }

    // 7. Certyfikaty ukończenia akademii — publiczny odczyt (weryfikacja autentyczności przez QR),
    // zapis wyłącznie dla zalogowanego właściciela UID z 28 lekcjami i 5 etapami, niezmienny po utworzeniu
    match /course_certificates/{certificateId} {
      allow read: if true;
      allow create: if isMember() && 
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.certificateId == certificateId &&
        request.resource.data.lessonsCompleted == 28 &&
        request.resource.data.stagesCompleted == 5 &&
        request.resource.data.recipientName is string &&
        request.resource.data.recipientName.size() >= 2 &&
        request.resource.data.recipientName.size() <= 100 &&
        request.resource.data.completedAt is string;
      allow update: if isMasterAdmin();
      allow delete: if isMasterAdmin();
    }

    // CC CONTENT CORE — Kanoniczny rejestr treści Christian Culture (Master Plan CC Global 2030)
    // Ochrona Pancernej Prywatności i Informacji Wewnętrznych:
    // Rejestr kanoniczny jest dostępny WYŁĄCZNIE dla Master Admina / Operatorów Mission Control
    // oraz zaufanego backendu Admin SDK.
    // Publiczny frontend pobiera wyłącznie dedykowane projekcje (np. lumina_posts, reflections).
    match /cc_content/{contentId} {
      allow read, write: if isMasterAdmin();

      match /variants/{variantId} {
        allow read, write: if isMasterAdmin();
      }

      match /assets/{assetId} {
        allow read, write: if isMasterAdmin();
      }

      match /publications/{pubId} {
        allow read, write: if isMasterAdmin();
      }

      match /audit/{auditId} {
        allow read, write: if isMasterAdmin();
      }
    }

    match /cc_content_meta/{docId} {
      allow read, write: if isMasterAdmin();
    }

    // CC Language & AI Content Factory (Faza 2)
    match /cc_theology_glossary/{termId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_translation_memory/{memoryId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_bible_sources/{sourceId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_ai_jobs/{jobId} {
      allow read, write: if isMasterAdmin();
    }

    // CC Distribution Engine (Faza 3)
    match /cc_distribution_jobs/{jobId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_publication_manifests/{manifestId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_distribution_plans/{planId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_distribution_killswitch/{docId} {
      allow read, write: if isMasterAdmin();
    }

    // CC Global Observer & Mission Intelligence (Faza 4 / Gate 4.5)
    // Anonymous: DENIED, Ordinary CC ID: DENIED, MasterAdmin / Backend: least privilege
    match /cc_analytics_events/{eventId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_analytics_snapshots/{snapshotId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_analytics_rollups/{rollupId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_platform_health/{componentId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_incidents/{incidentId} {
      allow read, write: if isMasterAdmin();
    }

    match /cc_observer_jobs/{jobId} {
      allow read, write: if isMasterAdmin();
    }

    // ── LUMI KIDS: dane pilotażu (logicznie odseparowane od LUMINA) ──────────────────
    match /kids_pilot/{docId} {
      allow read: if isMasterAdmin() || (
        docId == 'config' && isMember() && (
          resource.data.get('childUid', '') == request.auth.uid ||
          request.auth.uid in resource.data.get('contacts', [])
        )
      );
      allow write: if isMasterAdmin();
    }

    // Zaproszenie: adres e-mail to tylko identyfikator zaproszenia. Odczyt i przyjęcie wyłącznie
    // przez konto z ZWERYFIKOWANYM tym samym adresem (hasło ustawione przez użytkownika w Firebase Auth).
    match /kids_invites/{inviteId} {
      allow read: if isMasterAdmin() || (
        isMember() && request.auth.token.email_verified == true &&
        resource.data.email == request.auth.token.email.lower()
      );
      allow create, delete: if isMasterAdmin();
      allow update: if isMasterAdmin() || (
        isMember() &&
        request.auth.token.email_verified == true &&
        request.auth.token.firebase.sign_in_provider == 'password' &&
        resource.data.email == request.auth.token.email.lower() &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'claimed' &&
        request.resource.data.claimedUid == request.auth.uid &&
        request.resource.data.claimedAt == request.time &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedUid', 'claimedAt'])
      );
    }

    // Zgłoszenia rodzin do pilotażu (rodzic/opiekun, konto Google lub zweryfikowany e-mail).
    // Jedno zgłoszenie na konto; brak danych dziecka; odczyt: autor i administrator.
    match /kids_waitlist/{uid} {
      allow read: if isMasterAdmin() || (isMember() && uid == request.auth.uid);
      allow create: if isMember() && notKidsChild() &&
        uid == request.auth.uid &&
        request.auth.token.email_verified == true &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'parentName', 'childrenCount', 'message', 'consent', 'status', 'createdAt']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.email == request.auth.token.email &&
        request.resource.data.parentName is string &&
        request.resource.data.parentName.size() > 0 && request.resource.data.parentName.size() <= 80 &&
        request.resource.data.childrenCount is int &&
        request.resource.data.childrenCount >= 1 && request.resource.data.childrenCount <= 6 &&
        request.resource.data.message is string && request.resource.data.message.size() <= 500 &&
        request.resource.data.consent == true &&
        request.resource.data.status == 'new' &&
        request.resource.data.createdAt == request.time;
      allow update, delete: if isMasterAdmin();
    }

    // Wizytówki widoczne tylko wewnątrz pilotażu (nigdy w publicznym katalogu LUMINA).
    match /kids_profiles/{uid} {
      allow read: if isMasterAdmin() || (kidsActive() && (
        request.auth.uid == get(kidsConfigPath()).data.childUid ||
        request.auth.uid in get(kidsConfigPath()).data.get('contacts', [])
      ));
      allow write: if isMasterAdmin() || (
        kidsActive() && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['displayName', 'emoji', 'avatarUrl', 'birthDate', 'updatedAt']) &&
        request.resource.data.displayName is string &&
        request.resource.data.displayName.size() > 0 && request.resource.data.displayName.size() <= 40 &&
        request.resource.data.get('emoji', '') is string && request.resource.data.get('emoji', '').size() <= 8 &&
        (!('avatarUrl' in request.resource.data) || (request.resource.data.avatarUrl is string && request.resource.data.avatarUrl.size() <= 200)) &&
        (!('birthDate' in request.resource.data) || (request.resource.data.birthDate is string && request.resource.data.birthDate.size() <= 30))
      );
    }

    match /{topCollection}/{rest=**} {
      allow read, write: if isMasterAdmin() && topCollection != 'lumina_family_rooms' &&
        topCollection != 'lumi_agent_commands';
    }
  }
}

